# Copy locally to .env; never commit real secrets.
NODE_ENV=development
API_PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/vaani
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_PEPPER=replace-with-a-different-32-byte-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
WEB_ORIGINS=http://localhost:5173
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=50
REFRESH_RATE_MAX=120
# Set only to the exact number of trusted reverse proxies.
TRUST_PROXY_HOPS=0
# Set in apps/web/.env.local or the build environment.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional backend-only photo providers. Blank keys skip to open media/context.
# Never expose these through VITE_* variables.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
